# Browser-safe values (Vite embeds VITE_* values in the client bundle).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Leave empty to use the Vite /api proxy to localhost:8787.
VITE_API_URL=

# Server-only values. Never prefix these with VITE_.
# Use the Supabase pooler connection as user `postgres`; this is the
# administrative database role that bypasses RLS for the repository API.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# Needed for HS256 legacy/project JWTs. Asymmetric JWTs are verified with
# SUPABASE_URL's published JWKS; either verification method can be used.
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://your-project.supabase.co
# Only used by the API to publish Realtime Broadcast nudges.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
TICK_SECRET=replace-with-a-long-random-secret
PORT=8787
